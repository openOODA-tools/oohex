// # Model Context Protocol (MCP) Stdio Server for oohex
//
// Logline: Streaming JSON-RPC 2.0 stdio server providing hex dumps, diffs, and entropy stats.
//
// Setup: Demands FsReadCap for file inspection and stdio streaming without ambient authority.
//
// Beats:
//   1. Process incoming JSON-RPC 2.0 requests over standard input.
//   2. Dispatch initialize, tools/list, and tools/call methods.
//   3. Implement hex_dump, hex_inspect, hex_diff, hex_stats, and hex_demo tools.
//   4. Emit capability-bounded JSON-RPC responses for AI agents.

import "core/hex_types.oo";
import "core/hex_formatter.oo";
import "core/file_reader.oo";
import "render/render_table.oo";
import "render/render_json.oo";
import "render/render_demo.oo";
import "ipc/json_field.oo";
import "ipc/cli_options.oo";

pub fn run_mcp_server(fs: &FsReadCap) {
    let mut running: Bool = true;
    while running {
        let line_res: Result[String, String] = oo_read_stdin_chunk(fs, 8192);
        if !line_res.is_ok() {
            running = false;
        } else {
            let line: String = match line_res { Ok(s) => s, Err(_) => "" };
            let trimmed: String = str_trim(line);
            if chars_len(trimmed) == 0 {
                running = false;
            } else {
                let id: String = json_get_field(trimmed, "id");
                let method: String = json_get_string(trimmed, "method");

                if method == "initialize" {
                    let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                        ",\"result\":{\"protocolVersion\":\"2024-11-05\"," +
                        "\"serverInfo\":{\"name\":\"oohex\",\"version\":\"0.2.0\"}," +
                        "\"capabilities\":{\"tools\":{}}}}";
                    println(resp);
                } else if method == "notifications/initialized" {
                    // ack
                } else if method == "tools/list" {
                    let t1: String = "{\"name\":\"hex_dump\",\"description\":\"Format text or binary payload into canonical hex dump\"," +
                        "\"inputSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"},\"cols\":{\"type\":\"integer\"}},\"required\":[\"text\"]}}";
                    let t2: String = "{\"name\":\"hex_inspect\",\"description\":\"Inspect local file under FsReadCap with offset and length bounds\"," +
                        "\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"skip\":{\"type\":\"integer\"},\"length\":{\"type\":\"integer\"}},\"required\":[\"path\"]}}";
                    let t3: String = "{\"name\":\"hex_diff\",\"description\":\"Compare two text payloads and highlight byte deltas\"," +
                        "\"inputSchema\":{\"type\":\"object\",\"properties\":{\"text_a\":{\"type\":\"string\"},\"text_b\":{\"type\":\"string\"}},\"required\":[\"text_a\",\"text_b\"]}}";
                    let t4: String = "{\"name\":\"hex_stats\",\"description\":\"Compute byte frequency distribution and entropy metrics\"," +
                        "\"inputSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]}}";
                    let t5: String = "{\"name\":\"hex_demo\",\"description\":\"Run interactive binary dissection and delta comparison showcase\"," +
                        "\"inputSchema\":{\"type\":\"object\",\"properties\":{}}}";
                    let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                        ",\"result\":{\"tools\":[" + t1 + "," + t2 + "," + t3 + "," + t4 + "," + t5 + "]}}";
                    println(resp);
                } else if method == "tools/call" {
                    let params: String = json_get_field(trimmed, "params");
                    let tool_name: String = json_get_string(params, "name");
                    let args: String = json_get_field(params, "arguments");

                    if tool_name == "hex_dump" {
                        let text: String = json_get_string(args, "text");
                        let cols_str: String = json_get_string(args, "cols");
                        let cols: Int = if chars_len(cols_str) > 0 { parse_int_val(cols_str) } else { 16 };
                        let bytes: List[Int] = str_to_byte_list(text, 0, 0 - 1);
                        let tbl: String = render_hex_table(bytes, cols, 0, false, false);
                        let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                            ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"" + json_escape(tbl) + "\"}]}}";
                        println(resp);
                    } else if tool_name == "hex_inspect" {
                        let path: String = json_get_string(args, "path");
                        let skip_str: String = json_get_string(args, "skip");
                        let len_str: String = json_get_string(args, "length");
                        let skip: Int = if chars_len(skip_str) > 0 { parse_int_val(skip_str) } else { 0 };
                        let length: Int = if chars_len(len_str) > 0 { parse_int_val(len_str) } else { 64 };
                        let b_res: Result[List[Int], String] = read_bounded_bytes(fs, path, skip, length);
                        let text_out: String = match b_res {
                            Ok(bytes) => render_hex_table(bytes, 16, skip, false, false),
                            Err(e) => "Error reading file: " + e
                        };
                        let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                            ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"" + json_escape(text_out) + "\"}]}}";
                        println(resp);
                    } else if tool_name == "hex_diff" {
                        let text_a: String = json_get_string(args, "text_a");
                        let text_b: String = json_get_string(args, "text_b");
                        let bytes_a: List[Int] = str_to_byte_list(text_a, 0, 0 - 1);
                        let bytes_b: List[Int] = str_to_byte_list(text_b, 0, 0 - 1);
                        let diff_out: String = render_diff_table("input_a", bytes_a, "input_b", bytes_b, false);
                        let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                            ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"" + json_escape(diff_out) + "\"}]}}";
                        println(resp);
                    } else if tool_name == "hex_stats" {
                        let text: String = json_get_string(args, "text");
                        let bytes: List[Int] = str_to_byte_list(text, 0, 0 - 1);
                        let stats: HexStats = compute_stats(bytes);
                        let j: String = hex_stats_to_json(stats);
                        let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                            ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"" + json_escape(j) + "\"}]}}";
                        println(resp);
                    } else if tool_name == "hex_demo" {
                        let demo_out: String = run_hex_demo(false);
                        let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                            ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"" + json_escape(demo_out) + "\"}]}}";
                        println(resp);
                    } else {
                        let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                            ",\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}";
                        println(resp);
                    }
                } else {
                    let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                        ",\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}";
                    println(resp);
                }
            }
        }
    }
}
